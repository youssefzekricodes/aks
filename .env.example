# Copy to .env for local development:  cp .env.example .env      (PowerShell: Copy-Item)
# Never commit the real .env file — it is git-ignored. Keep THIS file free of real values.

# Exact public origin of the site (scheme + host + port, no trailing slash).
# Admin logins, contact requests and every mutation are only accepted from this origin.
APP_ORIGIN=http://localhost:3000

# --- Supabase (Project Settings → API) ---------------------------------------
# Used by the web server. The anon/publishable key is not secret: RLS decides access.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# Service-role key: ONLY for the maintenance scripts (admin:create, seed:demo,
# r2:cleanup). Never set it on the web server / hosting provider, never ship it
# to the browser. It bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (R2 → Manage API tokens: Object Read & Write on this bucket) --
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aks-media
# Public base URL of the bucket: custom domain (recommended) or the r2.dev URL.
R2_PUBLIC_URL=https://media.example.com
# Extra origins allowed to upload (comma-separated), e.g. http://127.0.0.1:3001 for dev.
R2_EXTRA_ORIGINS=

# --- Optional Cloudflare Turnstile on the contact form ------------------------
# When both are set, inquiries are only accepted with a valid Turnstile token.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional: end-to-end tests (npm test) ------------------------------------
# An admin account the integration test may sign in with (it creates and deletes
# one temporary draft car).
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# NOTE: do not put NODE_ENV, HOST or PORT in this file. Vite loads .env during
# `npm run build`, and a non-production NODE_ENV there makes the production build
# emit React's development JSX runtime (server rendering then fails). Set them in
# the host environment instead.

# --- Optional: one-off Facebook import (npm run import:facebook) -------------
# Apify API token (console.apify.com/settings/integrations), to read the scraped posts.
APIFY_TOKEN=

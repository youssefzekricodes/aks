    "label": "Prestations",
    "type": "collection",
    "value": "[{\"icon\": \"Banknote\", \"title\": \"Achat\", \"text\": \"Vous cherchez un véhicule dans notre showroom ? Notre équipe vous accompagne lors de l'achat neuf ou d'occasion.\"}, {\"icon\": \"Repeat\", \"title\": \"Vendre\", \"text\": \"Vous voulez vendre votre voiture ? Recevez une estimation claire et rapide de votre véhicule par notre équipe.\"}, {\"icon\": \"Wrench\", \"title\": \"Echange\", \"text\": \"Vous souhaitez échanger votre véhicule ? Contactez notre équipe pour organiser un essai ou valider les modalités.\"}, {\"icon\": \"Ship\", \"title\": \"Importation\", \"text\": \"Recherche et importation du modèle exact que vous voulez, options comprises.\"}, {\"icon\": \"ShieldCheck\", \"title\": \"Garantie\", \"text\": \"Jusqu'à 24 mois de garantie mécanique écrite sur les véhicules éligibles.\"}]"

    "key": "testimonials.items",
    "group": "testimonials",
    "label": "Avis clients",
    "type": "collection",
    "value": "[{\"name\":\"Mohamed Trabelsi\",\"city\":\"Sfax\",\"stars\":5,\"text\":\"Achat d'un SUV en toute confiance. Historique clair, essai sans pression et livraison en une semaine. Une équipe vraiment professionnelle.\"},{\"name\":\"Ines Charfi\",\"city\":\"Sakiet Ezzit\",\"stars\":5,\"text\":\"Ils ont repris mon ancienne voiture à un prix juste et monté le dossier de financement à ma place. Rien à redire.\"},{\"name\":\"Karim Bouzid\",\"city\":\"Sfax\",\"stars\":5,\"text\":\"Commande d'un modèle importé avec les options exactes que je voulais. Suivi impeccable du début à la fin.\"},{\"name\":\"Sarra Mahfoudh\",\"city\":\"Mahdia\",\"stars\":4,\"text\":\"Showroom impressionnant et conseils honnêtes. J'ai été orientée vers un modèle moins cher que prévu, et c'était le bon choix.\"}]"
  },
